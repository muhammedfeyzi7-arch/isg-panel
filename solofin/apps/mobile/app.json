{
  "expo": {
    "name": "SOLOFIN",
    "slug": "solofin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "solofin",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.solofin.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1730",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.solofin.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B1730"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Faturalarını uygulamaya eklemek için fotoğraflarına erişim gerekir.",
          "cameraPermission": "Faturaları fotoğraflamak için kameraya erişim gerekir."
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
