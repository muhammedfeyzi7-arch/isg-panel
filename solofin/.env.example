# SOLOFIN ortam değişkenleri
# Hiçbiri zorunlu değildir: değişken tanımlanmazsa uygulama yerel demo/yerel modda tam çalışır.
# Bu dosyayı .env.local olarak kopyalayıp doldurun. .env.local git'e EKLENMEZ.

# --- Supabase (canlı mod — istemci adaptörü henüz bağlanmadı, bkz. docs/BUILD_STATUS.md) ---
# İstemciye açık olması güvenli olan değerler (anon anahtar RLS ile korunur):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# YALNIZCA sunucu tarafında kullanılır. Asla NEXT_PUBLIC_ önekiyle tanımlamayın, istemciye göndermeyin:
SUPABASE_SERVICE_ROLE_KEY=

# --- Yapay zekâ katmanı (opsiyonel, henüz uygulanmadı) ---
# true yapılırsa Ayarlar'da "Etkin" görünür; anahtar yalnızca sunucu tarafında okunmalıdır.
NEXT_PUBLIC_AI_ENABLED=false
ANTHROPIC_API_KEY=

# --- Testler ---
# Playwright farklı bir Chromium kullanacaksa:
# PW_CHROMIUM_PATH=/opt/pw-browsers/chromium-1194/chrome-linux/chrome
